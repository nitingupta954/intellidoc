# ==========================================
# IntelliDoc AI - Environment Variables
# ==========================================
# Copy this file to .env and replace the placeholder values.

# ------------------------------------------
# Environment & Application Settings
# ------------------------------------------
NODE_ENV=development
# The frontend URL (used for CORS and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical Production URL (Required for SEO metadata)
NEXT_PUBLIC_SITE_URL=https://intellidoc-ivory.vercel.app
APP_URL=http://localhost:3000
ALLOWED_ORIGIN=http://localhost:3000

# The backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------
# Database (PostgreSQL / Prisma)
# ------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/intellidoc?schema=public

# ------------------------------------------
# Authentication (NextAuth & JWT)
# ------------------------------------------
# Generate a secret using: openssl rand -base64 32
AUTH_SECRET=your_super_secret_jwt_key_here
AUTH_TRUST_HOST=true

# GitHub OAuth
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------
# Redis & BullMQ (Caching, Session, Queue)
# ------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------
# Message Broker (RabbitMQ)
# ------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ------------------------------------------
# File Storage (AWS S3 / MinIO)
# ------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET=intellidoc-documents
S3_BUCKET_NAME=intellidoc-documents
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ------------------------------------------
# AI & Vector Embeddings
# ------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key
# Only required if using a custom local AI microservice
AI_SERVICE_URL=http://localhost:8000

TAVILY_API_KEY=
CRAG_PENDING_TTL_SECONDS=600
 
CRAG_SYNTHESIS_ENABLED=true
 
CRAG_RETRIEVAL_WEIGHT=0.4
CRAG_LLM_TOPIC_WEIGHT=0.4
CRAG_SYNTHESIS_BONUS=0.2

# Verdict thresholds on the blended score (re-tuned from 0.7/0.3 for the new formula).
# blended >= UPPER → CORRECT
# LOWER <= blended < UPPER → AMBIGUOUS (triggers best-effort synthesis or web-search confirm)
# blended < LOWER → INCORRECT
CRAG_UPPER_THRESHOLD=0.55
CRAG_LOWER_THRESHOLD=0.25

# ------------------------------------------
# Vector Database (Qdrant)
# ------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key (optional for local)

# ------------------------------------------
# Email (SMTP for Password Reset / Invites)
# ------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="IntelliDoc AI" <noreply@intellidoc.ai>

# ------------------------------------------
# Payments (Razorpay)
# ------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# ------------------------------------------
# Security — Internal Service Auth & Encryption
# ------------------------------------------
# Shared secret between Next.js and FastAPI. Both services MUST have the same value.
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=your_super_secret_internal_key

# AES-256-GCM encryption key for storing user API keys at rest in PostgreSQL.
# REQUIRED — the app will refuse to start without this.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ------------------------------------------
# Billing / Credit Wallet
# ------------------------------------------
LOW_BALANCE_THRESHOLD=5000
NEGATIVE_GRACE_CREDITS=2000

# ==========================================
# PRODUCTION (Vercel) Overrides
# ==========================================
# When deploying to Vercel, set these in the Vercel Dashboard:
#
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# APP_URL=https://your-domain.vercel.app
# ALLOWED_ORIGIN=https://your-domain.vercel.app
# AUTH_URL=https://your-domain.vercel.app
# AUTH_TRUST_HOST=true
# NEXT_PUBLIC_API_URL=https://intellidoc-ai-service.onrender.com/api/v1
# AI_SERVICE_URL=https://intellidoc-ai-service.onrender.com
#
# Also update on Render (AI Service):
#   ALLOWED_ORIGIN=https://your-domain.vercel.app
#
# And in Google Cloud Console:
#   Authorized redirect URI: https://your-domain.vercel.app/api/auth/callback/google

# ------------------------------------------
# Voice Input (Whisper) Configuration
# ------------------------------------------
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=en
VOICE_MAX_AUDIO_BYTES=10485760
VOICE_MAX_RECORDING_SECONDS=60
VOICE_RATE_LIMIT_RPM=20
VOICE_ALLOWED_MIME_TYPES=audio/webm,audio/mp4,audio/ogg
